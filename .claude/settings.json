{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.*.local)",
      "Bash(head .env)",
      "Bash(head .env.local)",
      "Bash(head .env.*.local)",
      "Bash(tail .env)",
      "Bash(tail .env.local)",
      "Bash(tail .env.*.local)",
      "Bash(less .env)",
      "Bash(less .env.local)",
      "Bash(less .env.*.local)",
      "Bash(more .env)",
      "Bash(more .env.local)",
      "Bash(more .env.*.local)",
      "Bash(source .env)",
      "Bash(source .env.local)",
      "Bash(source .env.*.local)",
      "Bash(grep * .env)",
      "Bash(grep * .env.local)",
      "Bash(grep * .env.*.local)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  }
}
